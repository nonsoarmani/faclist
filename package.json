{
  "name": "faclist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev ./public --d1=DB --compatibility-date=2025-01-01",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute faclist-db --local --file=./db/schema.sql && wrangler d1 execute faclist-db --local --file=./db/seed.sql",
    "db:init:remote": "wrangler d1 execute faclist-db --remote --file=./db/schema.sql && wrangler d1 execute faclist-db --remote --file=./db/seed.sql",
    "deploy": "wrangler pages deploy ./public --project-name=faclist",
    "import": "node scripts/import.mjs",
    "osm": "node scripts/osm.mjs",
    "add": "node scripts/add-country.mjs",
    "db:migrate:remote": "wrangler d1 execute faclist-db --remote --file=./db/migrations/002-richer-profiles.sql",
    "db:migrate:local": "wrangler d1 execute faclist-db --local --file=./db/migrations/002-richer-profiles.sql",
    "db:migrate3:remote": "wrangler d1 execute faclist-db --remote --file=./db/migrations/003-employee-range.sql",
    "db:migrate3:local": "wrangler d1 execute faclist-db --local --file=./db/migrations/003-employee-range.sql",
    "prep": "node scripts/prep-gigasheet.mjs",
    "db:migrate4:remote": "wrangler d1 execute faclist-db --remote --file=./db/migrations/004-sections.sql",
    "db:migrate4:local": "wrangler d1 execute faclist-db --local --file=./db/migrations/004-sections.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.99.0"
  }
}
